<Window x:Class="Calculadora.Visual.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora" Width="420" Height="740"
        ResizeMode="CanMinimize" WindowStyle="SingleBorderWindow"
        Background="#202020" Foreground="#FAFAFA" FontFamily="Segoe UI"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen" PreviewKeyDown="Janela_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background" Value="#3B3B3B"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#484848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fundo" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo" Property="Opacity" Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Operacao" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#323232"/>
        </Style>
        <Style x:Key="BotaoCabecalho" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Realce" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Realce" Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Realce" Property="Background" Value="#303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ItemMenu" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FundoItem" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FundoItem" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FundoItem" Property="Background" Value="#343434"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconeMenu" TargetType="Path">
            <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Geometry x:Key="IconePadrao">M6 3 H18 Q20 3 20 5 V20 Q20 22 18 22 H6 Q4 22 4 20 V5 Q4 3 6 3 Z M7 6 H17 V10 H7 Z M7 14 H8 M12 14 H13 M17 14 H17.1 M7 18 H8 M12 18 H13 M17 17 V20</Geometry>
        <Geometry x:Key="IconeCientifica">M9 3 H15 M10 3 V10 L5 19 Q4 21 7 21 H17 Q20 21 19 19 L14 10 V3 M8 15 H16 M9 18 H10</Geometry>
        <Geometry x:Key="IconeGrafico">M3 3 V21 H22 M7 17 L11 12 L15 14 L21 6 M7 7 V8 M7 11 V12 M11 18 H12 M16 18 H17</Geometry>
        <Geometry x:Key="IconeProgramador">M8 6 L2 12 L8 18 M16 6 L22 12 L16 18 M14 3 L10 21</Geometry>
        <Geometry x:Key="IconeData">M5 5 H19 Q21 5 21 7 V20 Q21 22 19 22 H5 Q3 22 3 20 V7 Q3 5 5 5 Z M3 10 H21 M7 2 V7 M17 2 V7 M7 14 H8 M12 14 H13 M17 14 H18 M7 18 H8 M12 18 H13</Geometry>
        <Geometry x:Key="IconeMoeda">M12 7 A5 5 0 1 1 2 7 A5 5 0 1 1 12 7 Z M22 7 A5 5 0 1 1 12 7 A5 5 0 1 1 22 7 Z M17 17 A5 5 0 1 1 7 17 A5 5 0 1 1 17 17 Z</Geometry>
        <Geometry x:Key="IconeVolume">M12 2 L22 7 V18 L12 23 L2 18 V7 Z M2 7 L12 12 L22 7 M12 12 V23</Geometry>
        <Geometry x:Key="IconeComprimento">M8 2 H16 V22 H8 Z M8 6 H12 M8 10 H14 M8 14 H12 M8 18 H14</Geometry>
        <Geometry x:Key="IconeMassa">M8 7 H16 L20 21 H4 Z M9 7 V5 A3 3 0 0 1 15 5 V7</Geometry>
        <Geometry x:Key="IconeTemperatura">M9 14 V5 A3 3 0 0 1 15 5 V14 A5 5 0 1 1 9 14 Z M12 7 V17 M14 18 A2 2 0 1 1 10 18 A2 2 0 1 1 14 18 Z</Geometry>
        <Geometry x:Key="IconeEnergia">M13 2 C13 7 6 8 7 13 C4 12 5 9 5 9 C1 15 5 22 12 22 C19 22 23 16 19 10 C19 14 16 15 16 12 C16 8 12 7 13 2 Z</Geometry>
        <Geometry x:Key="IconeArea">M6 3 H18 L23 21 H1 Z M4.3 9 H19.7 M2.7 15 H21.3 M10 3 L8 21 M14 3 L16 21</Geometry>
        <Geometry x:Key="IconeVelocidade">M17 4 A2 2 0 1 1 13 4 A2 2 0 1 1 17 4 Z M13 8 L9 13 L14 16 L12 22 M13 8 L17 11 H22 M10 9 L6 11 H2 M9 13 L6 18 H2 M14 16 L18 20 H22</Geometry>
        <Geometry x:Key="IconeConfiguracoes">M22.000,12.000 L19.944,13.580 L19.483,15.100 L20.315,17.556 L19.071,19.071 L16.500,18.735 L15.100,19.483 L13.951,21.808 L12.000,22.000 L10.420,19.944 L8.900,19.483 L6.444,20.315 L4.929,19.071 L5.265,16.500 L4.517,15.100 L2.192,13.951 L2.000,12.000 L4.056,10.420 L4.517,8.900 L3.685,6.444 L4.929,4.929 L7.500,5.265 L8.900,4.517 L10.049,2.192 L12.000,2.000 L13.580,4.056 L15.100,4.517 L17.556,3.685 L19.071,4.929 L18.735,7.500 L19.483,8.900 L21.808,10.049 Z M15.5 12 A3.5 3.5 0 1 1 8.5 12 A3.5 3.5 0 1 1 15.5 12 Z</Geometry>
    </Window.Resources>


    <Grid x:Name="LayoutCalculadora" Margin="4" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BotaoMenu" Grid.Column="0" Click="Menu_Click"
                    Style="{StaticResource BotaoCabecalho}" ToolTip="Modos de calculadora (Alt+M)"
                    AutomationProperties.Name="Abrir menu de modos">
                <Canvas Width="18" Height="14" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="EscalaMenu"/></Canvas.RenderTransform>
                    <Rectangle Width="18" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="White" Canvas.Top="0"/>
                    <Rectangle Width="18" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="White" Canvas.Top="6"/>
                    <Rectangle Width="18" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="White" Canvas.Top="12"/>
                </Canvas>
            </Button>
            <TextBlock x:Name="TituloModo" Grid.Column="1" Text="Padrão" Margin="8,0,0,0"
                       FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="Fixar" Grid.Column="2" Click="Fixar_Click"
                    Style="{StaticResource BotaoCabecalho}" ToolTip="Sempre visível"
                    AutomationProperties.Name="Ativar ou desativar sempre visível">
                <Path Data="M 3,15 L 15,3 M 6,3 L 15,3 L 15,12" StrokeThickness="1.7"
                      Width="18" Height="18" RenderTransformOrigin="0.5,0.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke><SolidColorBrush x:Name="CorSeta" Color="White"/></Path.Stroke>
                    <Path.RenderTransform><TranslateTransform x:Name="MovimentoSeta"/></Path.RenderTransform>
                </Path>
            </Button>
            <Grid Grid.Column="3">
                <Button x:Name="BotaoPassos" Click="Painel_Click"
                        Style="{StaticResource BotaoCabecalho}"
                        ToolTip="Resolução passo a passo (F2)"
                        AutomationProperties.Name="Abrir resolução passo a passo">
                    <Canvas Width="18" Height="14" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><ScaleTransform x:Name="EscalaTracos"/></Canvas.RenderTransform>
                        <Rectangle Width="18" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="White" Canvas.Top="0"/>
                        <Rectangle Width="18" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="White" Canvas.Top="6"/>
                        <Rectangle Width="18" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="White" Canvas.Top="12"/>
                    </Canvas>
                </Button>
                <Ellipse x:Name="AvisoPassos" Width="7" Height="7" Fill="#4CC2FF"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,5,4,0" Visibility="Collapsed" IsHitTestVisible="False"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="EscalaAviso"/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Grid>
        <TextBlock x:Name="Resumo" Grid.Row="1" Margin="12,0" Foreground="#AAAAAA"
                   TextAlignment="Right" TextTrimming="CharacterEllipsis" FontSize="14"/>
        <TextBox x:Name="Entrada" Grid.Row="2" Text="0" FontSize="46" FontWeight="SemiBold"
                 Background="Transparent" Foreground="White" CaretBrush="White"
                 BorderThickness="0" TextAlignment="Right" VerticalContentAlignment="Center"
                 Padding="12" HorizontalScrollBarVisibility="Auto"
                 TextChanged="Entrada_TextChanged" KeyDown="Entrada_KeyDown"
                 PreviewTextInput="Entrada_PreviewTextInput"/>
        <TextBlock x:Name="Erro" Grid.Row="3" Foreground="Salmon" FontSize="12"
                   Margin="12,0" TextWrapping="Wrap"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="(" Tag="(" Click="Tecla_Click" FontSize="16" MinHeight="24"
                    Style="{StaticResource Operacao}" ToolTip="Abrir parêntese"/>
            <Button Grid.Column="1" Content=")" Tag=")" Click="Tecla_Click" FontSize="16" MinHeight="24"
                    Style="{StaticResource Operacao}" ToolTip="Fechar parêntese"/>
        </Grid>
        <UniformGrid Grid.Row="5" Columns="4">
            <Button Content="%" Tag="%" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="CE" Tag="CE" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="C" Tag="C" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="⌫" Tag="back" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="1/x" Tag="inverse" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="x²" Tag="square" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="√x" Tag="sqrt" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="÷" Tag="/" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="7" Tag="7" Click="Tecla_Click"/>
            <Button Content="8" Tag="8" Click="Tecla_Click"/>
            <Button Content="9" Tag="9" Click="Tecla_Click"/>
            <Button Content="×" Tag="*" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="4" Tag="4" Click="Tecla_Click"/>
            <Button Content="5" Tag="5" Click="Tecla_Click"/>
            <Button Content="6" Tag="6" Click="Tecla_Click"/>
            <Button Content="−" Tag="-" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="1" Tag="1" Click="Tecla_Click"/>
            <Button Content="2" Tag="2" Click="Tecla_Click"/>
            <Button Content="3" Tag="3" Click="Tecla_Click"/>
            <Button Content="+" Tag="+" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="+/-" Tag="sign" Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="0" Tag="0" Click="Tecla_Click"/>
            <Button Content="," Tag="," Click="Tecla_Click" Style="{StaticResource Operacao}"/>
            <Button Content="=" Tag="=" Click="Tecla_Click" Background="#4CC2FF" Foreground="#10212A" BorderBrush="#4CC2FF"/>
        </UniformGrid>

        <!-- Overlays stay in the existing window and do not change its size. -->
        <Border x:Name="FundoPainel" Grid.Row="0" Grid.RowSpan="6"
                Panel.ZIndex="10" Background="#99000000" Visibility="Collapsed"
                MouseLeftButtonDown="FundoPainel_Click"/>
        <Border x:Name="PainelPassos" Grid.Row="4" Grid.RowSpan="2"
                Panel.ZIndex="11" Background="#282828" CornerRadius="10,10,0,0"
                BorderBrush="#424242" BorderThickness="1,1,1,0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DeslocamentoPainel"/>
            </Border.RenderTransform>
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Resolução passo a passo" FontSize="17"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" FontSize="15"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="Fechar (Esc)" Click="FecharPainel_Click"/>
                </Grid>
                <TextBox x:Name="TextoPassos" Grid.Row="1" IsReadOnly="True"
                         Background="Transparent" Foreground="#EEEEEE"
                         BorderThickness="0" FontFamily="Consolas" FontSize="19"
                         TextWrapping="Wrap" Padding="3,14,3,4"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
        <Border x:Name="FundoMenu" Grid.Row="0" Grid.RowSpan="6" Panel.ZIndex="20"
                Background="#66000000" Visibility="Collapsed"
                MouseLeftButtonDown="FundoMenu_Click"/>
        <Border x:Name="BarraMenu" Grid.Row="0" Grid.RowSpan="6" Panel.ZIndex="21"
                Width="280" HorizontalAlignment="Left" Background="#292929"
                BorderBrush="#3D3D3D" BorderThickness="0,0,1,0" CornerRadius="0,8,8,0"
                Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="DeslocamentoMenu" X="-280"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="54"/>
                </Grid.RowDefinitions>
                <Button x:Name="FecharBotaoMenu" Focusable="True" Width="36" HorizontalAlignment="Left" Margin="10,2"
                        Content="≡" Style="{StaticResource BotaoCabecalho}" Click="Menu_Click"
                        ToolTip="Fechar menu (Esc)" AutomationProperties.Name="Fechar menu de modos"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,0,8">
                        <TextBlock Text="Calculadora" FontSize="14" FontWeight="SemiBold" Foreground="#CCCCCC"
                                   Margin="16,14,0,10"/>
                    <Button Style="{StaticResource ItemMenu}" Click="Padrao_Click" Background="#363636" ToolTip="Modo atual"
                            AutomationProperties.Name="Padrão">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="3" Height="20" Background="#4CC2FF" CornerRadius="1.5"
                                    HorizontalAlignment="Left"/>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconePadrao}"/>
                            <TextBlock Grid.Column="1" Text="Padrão" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Científica">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeCientifica}"/>
                            <TextBlock Grid.Column="1" Text="Científica" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Representação gráfica">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeGrafico}"/>
                            <TextBlock Grid.Column="1" Text="Representação gráfica" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Programador">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeProgramador}"/>
                            <TextBlock Grid.Column="1" Text="Programador" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Cálculo de data">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeData}"/>
                            <TextBlock Grid.Column="1" Text="Cálculo de data" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                        <TextBlock Text="Conversor" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCCCCC" Margin="16,18,0,10"/>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Moeda">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeMoeda}"/>
                            <TextBlock Grid.Column="1" Text="Moeda" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Volume">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeVolume}"/>
                            <TextBlock Grid.Column="1" Text="Volume" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Comprimento">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeComprimento}"/>
                            <TextBlock Grid.Column="1" Text="Comprimento" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Peso e massa">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeMassa}"/>
                            <TextBlock Grid.Column="1" Text="Peso e massa" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Temperatura">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeTemperatura}"/>
                            <TextBlock Grid.Column="1" Text="Temperatura" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Energia">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeEnergia}"/>
                            <TextBlock Grid.Column="1" Text="Energia" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Área">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeArea}"/>
                            <TextBlock Grid.Column="1" Text="Área" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Velocidade">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeVelocidade}"/>
                            <TextBlock Grid.Column="1" Text="Velocidade" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="#414141" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource ItemMenu}" IsEnabled="False" ToolTip="Em breve — este modo ainda não foi implementado"
                            AutomationProperties.Name="Configurações">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconeMenu}" Data="{StaticResource IconeConfiguracoes}"/>
                            <TextBlock Grid.Column="1" Text="Configurações" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
